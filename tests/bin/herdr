#!/usr/bin/env python3
"""Fake herdr for tests. Logs argv to $FAKE_HERDR_LOG (one JSON list per
line) and keeps a tiny world in $FAKE_HERDR_STATE. $FAKE_HERDR_FAIL makes
any call whose argv starts with that space separated prefix fail."""

import json
import os
import sys

argv = sys.argv[1:]
logged = argv
if os.environ.get("FAKE_HERDR_LOG_SOCKET"):  # prefix each logged call with the server it was aimed at
    logged = ["@" + os.environ.get("HERDR_SOCKET_PATH", "")] + argv
with open(os.environ["FAKE_HERDR_LOG"], "a") as f:
    f.write(json.dumps(logged) + "\n")

path = os.environ["FAKE_HERDR_STATE"]
world = json.load(open(path)) if os.path.exists(path) else {}
world.setdefault("n", 10)
world.setdefault("tabs", {})
world.setdefault("workspaces", {})
world.setdefault("agents", [])


def out(result, code=0):
    json.dump(world, open(path, "w"))
    print(json.dumps({"id": "fake", "result": result}))
    sys.exit(code)


def fail(msg):
    json.dump(world, open(path, "w"))
    print(json.dumps({"id": "fake", "error": {"code": "fake_error", "message": msg}}))
    sys.exit(1)


fail_prefix = os.environ.get("FAKE_HERDR_FAIL", "").split()
if fail_prefix and argv[: len(fail_prefix)] == fail_prefix:
    fail("injected failure")


def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None


def new_id(prefix):
    world["n"] += 1
    return f"{prefix}{world['n']}"


cmd = argv[:2]
if cmd == ["tab", "create"]:
    ws = opt("--workspace")
    tab, pane = f"{ws}:{new_id('t')}", f"{ws}:{new_id('p')}"
    world["tabs"][tab] = {"label": opt("--label"), "workspace_id": ws, "pane_id": pane}
    out({"type": "tab_created", "tab": {"tab_id": tab, "workspace_id": ws, "label": opt("--label")},
         "root_pane": {"pane_id": pane, "tab_id": tab, "workspace_id": ws}})
elif cmd == ["workspace", "create"]:
    ws = new_id("w")
    tab, pane = f"{ws}:{new_id('t')}", f"{ws}:{new_id('p')}"
    world["workspaces"][ws] = {"label": opt("--label")}
    world["tabs"][tab] = {"label": opt("--label"), "workspace_id": ws, "pane_id": pane}
    out({"type": "workspace_created", "workspace": {"workspace_id": ws, "label": opt("--label"), "active_tab_id": tab},
         "tab": {"tab_id": tab, "workspace_id": ws}, "root_pane": {"pane_id": pane, "tab_id": tab, "workspace_id": ws}})
elif cmd == ["workspace", "list"]:
    out({"type": "workspace_list", "workspaces": [
        {"workspace_id": k, "label": v["label"]} for k, v in world["workspaces"].items()]})
elif cmd == ["workspace", "rename"]:
    world["workspaces"].setdefault(argv[2], {})["label"] = " ".join(argv[3:])
    out({"type": "ok"})
elif cmd == ["tab", "list"]:
    out({"type": "tab_list", "tabs": [{"tab_id": k, **v} for k, v in world["tabs"].items()]})
elif cmd == ["tab", "rename"]:
    if argv[2] not in world["tabs"]:
        fail("tab not found")
    world["tabs"][argv[2]]["label"] = " ".join(argv[3:])
    out({"type": "ok"})
elif cmd == ["tab", "close"]:
    if world["tabs"].pop(argv[2], None) is None:
        fail("tab not found")
    world["agents"] = [a for a in world["agents"] if a.get("tab_id") != argv[2]]
    out({"type": "ok"})
elif cmd == ["agent", "start"]:
    name, pane = argv[2], opt("--pane")
    extra = argv[argv.index("--") + 1:] if "--" in argv else []
    sid = None
    for flag in ("--session-id", "--resume"):
        if flag in extra:
            sid = extra[extra.index(flag) + 1]
    tab = next((k for k, v in world["tabs"].items() if v["pane_id"] == pane), None)
    world["agents"].append({"name": name, "agent": "claude", "pane_id": pane, "tab_id": tab,
                            "agent_status": "idle",
                            "agent_session": {"kind": "id", "value": sid} if sid else None})
    out({"type": "agent_started", "agent": {"name": name, "pane_id": pane}})
elif cmd == ["pane", "move"]:
    old_pane = argv[2]
    ws = new_id("w")
    tab, pane = f"{ws}:{new_id('t')}", f"{ws}:{new_id('p')}"
    world["workspaces"][ws] = {"label": opt("--label")}
    world["tabs"] = {k: v for k, v in world["tabs"].items() if v.get("pane_id") != old_pane}
    world["tabs"][tab] = {"label": "1", "workspace_id": ws, "pane_id": pane}
    for a in world["agents"]:
        if a.get("pane_id") == old_pane:
            a.update(pane_id=pane, tab_id=tab, workspace_id=ws)
    out({"type": "pane_move", "move_result": {"created_workspace": {"workspace_id": ws},
         "pane": {"pane_id": pane, "tab_id": tab, "workspace_id": ws}}})
elif cmd == ["pane", "read"]:
    print(world.get("screens", {}).get(argv[2], "────\n❯ \n────\n  status line"))
    json.dump(world, open(path, "w"))
    sys.exit(0)
elif cmd == ["agent", "prompt"]:
    out({"type": "ok"})
elif cmd == ["agent", "list"]:
    out({"type": "agent_list", "agents": world["agents"]})
else:
    fail(f"fake herdr does not know {argv}")
